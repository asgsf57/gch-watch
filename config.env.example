# Copy to config.env and fill in. config.env is gitignored.
CHECK_IN=YYYY-MM-DD
CHECK_OUT=YYYY-MM-DD
HOTEL=grand-californian-hotel
ADULTS=2
CHILDREN=0
CHILD_AGES=
# Long random string; install the ntfy app and subscribe to the same value.
NTFY_TOPIC=

# Pushcut webhook URL (contains a secret). Get it in the Pushcut app.
PUSHCUT_URL=
